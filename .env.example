PORT=3000
# Use 0.0.0.0 for a container behind HTTPS proxy.
HOST=127.0.0.1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required by email submission settlement and the unattended inbox worker. Never exposed to browser.
SUPABASE_SERVICE_ROLE_KEY=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_FOLDER_ID=
GRAPH_ALLOWED_SENDER=
# Absolute or repository-relative path, copied from config/example.json and completed.
INTEGRATION_CONFIG=config/live.json
